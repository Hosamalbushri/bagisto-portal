{
    "name": "platform/portal-ui",
    "description": "Bagisto Portal UI and Admin Blade Component Library.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Hosam",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3 <8.5",
        "illuminate/view": "^11.0|^12.0",
        "blade-ui-kit/blade-heroicons": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Platform\\PortalUi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Platform\\PortalUi\\Providers\\UiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
