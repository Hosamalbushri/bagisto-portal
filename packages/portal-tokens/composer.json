{
    "name": "platform/portal-tokens",
    "description": "Design token compilation, derivation and W3C DTCG engine for Bagisto Portal.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Hosam",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3 <8.5",
        "illuminate/support": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Platform\\PortalTokens\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Platform\\PortalTokens\\Providers\\TokensServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
