{
    "name": "platform/portal-sections-api",
    "description": "Clean, extensible Sections API contract and registry for Bagisto Portal.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Hosam",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3 <8.5",
        "illuminate/support": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Platform\\PortalSectionsApi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Platform\\PortalSectionsApi\\Providers\\SectionsApiServiceProvider"
            ],
            "aliases": {
                "PortalSection": "Platform\\PortalSectionsApi\\Facades\\PortalSection"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
