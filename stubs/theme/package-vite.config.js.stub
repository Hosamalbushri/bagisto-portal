import { defineConfig, loadEnv } from 'vite';
import laravel from 'laravel-vite-plugin';
import path from 'path';

export default defineConfig(({ mode }) => {
    const envDir = '../../../../';
    Object.assign(process.env, loadEnv(mode, envDir));

    return {
        build: {
            emptyOutDir: true,
            minify: 'esbuild',
            cssCodeSplit: true,
        },

        envDir,

        plugins: [
            laravel({
                hotFile: path.resolve(__dirname, '../../../../public/portal-{{ themeCode }}-vite.hot'),
                publicDirectory: path.resolve(__dirname, '../../../../public'),
                buildDirectory: 'themes/portal/{{ themeCode }}/build',
                input: [
                    'packages/{{ vendor }}/{{ packageName }}/src/Resources/assets/css/app.css',
                    'packages/{{ vendor }}/{{ packageName }}/src/Resources/assets/js/app.js',
                ],
                refresh: true,
            }),
        ],
    };
});

