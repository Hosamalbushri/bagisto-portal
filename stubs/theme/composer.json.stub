{
    "name": "{{ composerVendor }}/{{ composerPackage }}",
    "description": "{{ description }}",
    "type": "bagisto-theme",
    "license": "MIT",
    "authors": [
        {
            "name": "{{ vendor }}",
            "email": "developer@example.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "platform/portal": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "{{ vendor }}\\{{ packageName }}\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "{{ vendor }}\\{{ packageName }}\\Providers\\{{ packageName }}ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

