@props([
    'options' => [],
    'section' => null,
])

@php
    $heading = $options['heading'] ?? '';
    $subheading = $options['subheading'] ?? '';
    $showButton = ! empty($options['show_button']);
    $buttonText = $options['button_text'] ?? '';
    $buttonUrl = $options['button_url'] ?? '#';
@endphp

<section class="py-16 md:py-24 bg-[var(--bg-app)] text-[var(--text-primary)] transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        @if ($heading)
            <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight font-cairo">
                {{ $heading }}
            </h2>
        @endif

        @if ($subheading)
            <p class="mt-4 text-lg md:text-xl text-[var(--text-secondary)] max-w-3xl mx-auto font-cairo">
                {{ $subheading }}
            </p>
        @endif

        @if ($showButton && $buttonText)
            <div class="mt-8 flex justify-center">
                <a
                    href="{{ portal_sanitize_url($buttonUrl) }}"
                    class="inline-flex items-center px-6 py-3 border border-transparent text-base font-semibold rounded-xl text-white bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] shadow-sm transition-all duration-150"
                >
                    {{ $buttonText }}
                </a>
            </div>
        @endif
    </div>
</section>

